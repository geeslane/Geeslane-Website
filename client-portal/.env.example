# Public values only. Never add Resend, SMTP, service-role, or access-token secrets here.
# COMMUNITY_MANAGER_EMAIL is not a website setting. Set it only as a Supabase
# Edge Function secret for send-portal-mail. Do not put a real address in this file.
# One address, or several separated by commas.
# COMMUNITY_MANAGER_EMAIL=one@example.com,two@example.com
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPPORT_EMAIL=contact@geeslane.com
# Administrator password login.
# ADMIN_USERNAME / ADMIN_PASSWORD are the local shortcut (e.g. admin / admin).
# ADMIN_EMAIL must be the real administrator email in Supabase Auth.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Public Paystack key only. The secret stays in Supabase Edge Function secrets.
PAYSTACK_PUBLIC_KEY=
